# ToolNest Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# Never commit real credentials or secret tokens to source control.

# Application Environment
ENVIRONMENT=development
DEBUG=false
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=

# Database Connection (Neon PostgreSQL)
# Format: postgresql://username:password@ep-sample-12345.ap-southeast-1.aws.neon.tech/toolnest?sslmode=require
DATABASE_URL=

# Admin Authentication & Session Security
# Generate a strong 32+ character random string in production (e.g., openssl rand -hex 32)
ADMIN_SECRET_KEY=replace-with-a-secure-random-32-char-secret-in-production
# Set COOKIE_SECURE=true in production/HTTPS to enforce secure-only cookie transmission
COOKIE_SECURE=false

# API Documentation (Optional: set to true if you need /docs exposed in production)
ENABLE_API_DOCS=false

# Static Site Publishing (Render -> GitHub -> Cloudflare Pages)
# Used only by the static publisher service in Phase 3
GITHUB_TOKEN=
GITHUB_REPOSITORY=

